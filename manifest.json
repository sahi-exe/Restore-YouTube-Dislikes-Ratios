{
  "manifest_version": 3,
  "name": "YT Dislike Restorer",
  "version": "1.0.0",
  "description": "Seamlessly restores the dislike count on YouTube videos.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://returnyoutubedislikeapi.com/*"
  ]
}